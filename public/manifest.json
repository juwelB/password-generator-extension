{
  "manifest_version": 3,
  "name": "Password Generator",
  "version": "0.1.0",
  "description": "Generates strong random passwords instantly. Nothing is stored or sent anywhere.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Generate a password",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
